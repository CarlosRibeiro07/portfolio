# Copie para .env apenas para testar no seu computador. Nunca envie o .env ao GitHub.
DATABASE_URL=postgres://usuario:senha@localhost:5432/portfolio
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# E-mail do administrador (necessário para ele recuperar a senha)
ADMIN_EMAIL=seu-email@exemplo.com
PORT=3000

# --- E-mail (esqueci minha senha). Escolha UMA das opções ---
# Opção A (recomendada no Render gratuito): Resend, por API
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Portfólio <nao-responda@seudominio.com.br>
# Opção B: SMTP (plano pago do Render, outro host ou teste local)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_SECURE=false
# MAIL_FROM=Portfólio <nao-responda@seudominio.com.br>
# Endereço público do site (usado no link do e-mail). No Render é preenchido sozinho.
# APP_URL=https://seu-site.onrender.com
